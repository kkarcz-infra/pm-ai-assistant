# Skopiuj do .env (plik jest ignorowany przez git) i dostosuj, jeśli zmieniasz
# porty lub dane lokalnego MySQL.

PORT=8080
NODE_ENV=development
APP_REGION=local

# Tryb lokalny / Docker: połączenie przez TCP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appdb
DB_USER=app
DB_PASSWORD=app_local_password

# Tryb Cloud Run: zamiast DB_HOST i DB_PORT ustawiamy ścieżkę do socketu.
# Wartość jest montowana przez wbudowany Cloud SQL Auth Proxy.
# DB_SOCKET=/cloudsql/liquid-streamer-284510:europe-central2:cloudrun-lab-mysql
